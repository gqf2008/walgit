#!/usr/bin/env bash
# walgit-ensure — 确保本机 walgit 服务在跑（幂等）；status / stop 子命令
set -euo pipefail

BASE="$HOME/walgit"
URL="http://127.0.0.1:8081"
HEALTH_URL="$URL/healthz"

is_running() {
  curl -sf -o /dev/null --max-time 2 "$HEALTH_URL" 2>/dev/null
}

get_pid() {
  lsof -tiTCP:8081 -sTCP:LISTEN 2>/dev/null | head -1
}

case "${1:-ensure}" in
  status)
    if is_running; then
      pid="$(get_pid)"
      echo "walgit: running (pid ${pid:-?}) — $URL"
    else
      echo "walgit: not running — $URL"
      exit 1
    fi
    exit 0
    ;;
  stop)
    screen -S walgit-server -X quit 2>/dev/null || true
    pid="$(get_pid || true)"
    if [ -n "$pid" ]; then kill "$pid" 2>/dev/null || true; fi
    # 等待完全退出（最多 10s）
    for i in $(seq 1 10); do
      if ! is_running && [ -z "$(get_pid || true)" ]; then
        echo "walgit: stopped"
        exit 0
      fi
      sleep 1
    done
    echo "walgit: stop failed — still running" >&2
    exit 1
    ;;
  ensure|start|"")
    if is_running; then
      echo "walgit: already running (pid $(get_pid)) — $URL"
      exit 0
    fi
    # 校验部署完整性
    if [ ! -x "$BASE/walgit" ] || [ ! -f "$BASE/walgit.toml" ] || [ ! -x "$BASE/run-walgit.sh" ]; then
      echo "walgit: 部署不完整（缺 $BASE 下的 walgit / walgit.toml / run-walgit.sh）" >&2
      exit 1
    fi
    if [ ! -r "$BASE/.r2-credentials" ]; then
      echo "walgit: 缺少 R2 凭证 $BASE/.r2-credentials" >&2
      exit 1
    fi
    # screen 保活启动（exec 会话会回收裸后台进程）
    screen -dmS walgit-server bash -c "cd $BASE && ./run-walgit.sh > $BASE/server.log 2>&1; echo EXIT=\$? >> $BASE/server.log"
    # 等待就绪（最多 15s）
    for i in $(seq 1 15); do
      if is_running; then
        echo "walgit: started (pid $(get_pid)) — $URL"
        exit 0
      fi
      sleep 1
    done
    echo "walgit: 启动失败，日志尾部：" >&2
    tail -5 "$BASE/server.log" 2>/dev/null >&2 || true
    exit 1
    ;;
  *)
    echo "用法: walgit-ensure [ensure|status|stop]" >&2
    exit 2
    ;;
esac
