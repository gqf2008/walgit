{
  "name": "walgit-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "build": "oxlint --deny-warnings && tsc --noEmit && vite build && vite build -c vite.sdk.config.ts",
    "preview": "vite preview",
    "build:sdk": "vite build -c vite.sdk.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@pierre/diffs": "^1.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.78.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "vitest": "^5.0.0"
  }
}
